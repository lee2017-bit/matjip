// Cloudflare Workers 설정 (대시보드에서 이 저장소를 연결할 때 Root directory = worker)
{
  "name": "matjip-lookup",
  "main": "lookup.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  // '물어보기'용 Workers AI (Free 플랜은 하루 10,000 뉴런 무료, 넘으면 과금 없이 오류)
  "ai": { "binding": "AI" },
  // '물어보기' 질문 캐시·하루 질문 수 (workers.dev 에서는 Cache API가 동작하지 않아서). Free 플랜의 SQLite Durable Object
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "ChatStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatStore"] }]
}
